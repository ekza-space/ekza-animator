# Ekza Studio generation gateway (ekza-gen/v1) — standalone server environment. Copy to a root-only file
# (e.g. /opt/ekza-dev/secrets/gen-gateway.env, mode 0600). Never commit real values.

# Default deny: nothing is served without this.
GEN_GATEWAY_ENABLED=1

# Auth. Behind a reverse proxy a token is required (loopback mode refuses proxied requests).
# 32+ random characters, e.g. `openssl rand -hex 32`; give it to the editor users who may spend the operator's credits.
GEN_GATEWAY_TOKEN=

# Bind to loopback; the reverse proxy (Caddy) terminates TLS.
GEN_GATEWAY_HOST=127.0.0.1
GEN_GATEWAY_PORT=18787

# Server spend caps in USD, applied whatever a client asks (required).
GEN_CAP_DAILY_USD=5
GEN_CAP_MONTHLY_USD=30

# Browser origins allowed by CORS: the static editor build(s) that point at this gateway.
GEN_ALLOWED_ORIGINS=https://studio.dev.ekza.io

# Persistent jobs and blobs (survive restarts; no prompt text is stored).
GEN_DATA_DIR=/var/lib/ekza-gen-gateway

# Provider keys (self-hosted mode). Leave empty to disable a provider.
TRIPO_API_KEY=
MESHY_API_KEY=

# Webhooks (optional; polling works without them). GEN_PUBLIC_URL is this gateway's public https base; register
# ${GEN_PUBLIC_URL}/v1/hooks/tripo in the Tripo console (signed, needs the secret) and /v1/hooks/meshy at Meshy.
GEN_PUBLIC_URL=
TRIPO_WEBHOOK_SECRET=

# Bring-your-own keys (X-Gen-Provider-Key) stay off until Q-GEN-4 is answered in writing.
GEN_BYO_KEYS=0

# Kill switch: 1 refuses new jobs (running ones finish).
GEN_GATEWAY_PAUSED=0

GEN_LOG_LEVEL=info
