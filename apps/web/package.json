{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Next.js 16 shell for Ekza Studio: landing page, /editor client island, e2e specs.",
  "license": "MIT",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs && node scripts/third-party-notices.mjs",
    "dev": "node scripts/copy-assets.mjs && next dev",
    "build": "node scripts/copy-assets.mjs && node scripts/third-party-notices.mjs && next build",
    "check:size": "node scripts/check-size.mjs",
    "clean:next": "node scripts/clean-next.mjs",
    "size:attribute": "node scripts/attribute-chunks.mjs",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "e2e": "playwright test",
    "bench:budgets": "playwright test -c e2e/bench/playwright.config.ts"
  },
  "dependencies": {
    "@ekza-studio/autorig": "workspace:*",
    "@ekza-studio/editor": "workspace:*",
    "@ekza-studio/ui": "workspace:*",
    "@pixiv/three-vrm": "catalog:",
    "@pixiv/three-vrm-animation": "catalog:",
    "next": "16.3.8",
    "react": "catalog:",
    "react-dom": "catalog:",
    "three": "catalog:"
  },
  "devDependencies": {
    "@ekza-studio/doc": "workspace:*",
    "@ekza-studio/io": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "catalog:",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "vitest": "catalog:",
    "vrm-validator": "2.0.0-dev.3.10"
  }
}
