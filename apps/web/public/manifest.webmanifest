{
  "id": "/app",
  "name": "Ekza Studio",
  "short_name": "Ekza Studio",
  "description": "Make, rig and animate 3D characters. Nothing is uploaded.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "any",
  "background_color": "#1b1c1f",
