{
  "name": "ekza-animator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source, browser-based character animator for glTF and VRM with a Maya-grade workflow.",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "test": "turbo run test test:tooling",
    "test:tooling": "node --test \"tooling/test/*.test.mjs\"",
    "test:e2e": "pnpm run mcp:build && pnpm --filter web e2e",
    "mcp:build": "pnpm --filter ekza-animator-mcp build",
    "evals": "pnpm --filter @ekza-animator/agent-evals test",
    "lint": "oxlint --type-aware",
    "format": "biome format --write",
    "format:check": "biome format",
    "typecheck": "tsc -b",
    "check:deps": "node tooling/check-deps.mjs",
    "check:fixtures": "node tooling/check-fixtures.mjs",
    "check:licenses": "node tooling/check-licenses.mjs",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run check:deps && pnpm run check:fixtures && pnpm run check:licenses && pnpm run test && pnpm run build && pnpm --filter web check:size && pnpm run test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "catalog:",
    "meshoptimizer": "1.3.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "1.63.0",
    "turbo": "2.11.7",
    "typescript": "catalog:"
  }
}
